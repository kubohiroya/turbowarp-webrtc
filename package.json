{
  "name": "@kubohiroya/turbowarp-webrtc",
  "version": "0.1.0",
  "description": "Manual WebRTC DataChannel pairing for TurboWarp extensions.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-webrtc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-webrtc.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-webrtc/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "webrtc",
    "datachannel",
    "manual-pairing"
  ],
  "type": "module",
  "files": [
    "dist/",
    "schemas/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests scripts vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "pnpm run check && pnpm publish --dry-run --access public --no-git-checks",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
